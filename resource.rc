#define STRINGIFY2(x) #x
#define STRINGIFY(x)  STRINGIFY2(x)
#define WIDEN2(x)     L##x
#define WIDEN(x)      WIDEN2(x)
#define RCSTR(x)      WIDEN(STRINGIFY(x\0))

IDI_APP_ICON ICON "icon.ico"

1 VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      RCSTR(APP_PUBLISHER)
            VALUE "FileDescription",  RCSTR(APP_NAME)
            VALUE "FileVersion",      RCSTR(VERSION_MAJOR.VERSION_MINOR.VERSION_PATCH.VERSION_BUILD)
            VALUE "ProductVersion",   RCSTR(VERSION_MAJOR.VERSION_MINOR.VERSION_PATCH.VERSION_BUILD)
            VALUE "InternalName",     RCSTR(APP_NAME.exe)
            VALUE "OriginalFilename", RCSTR(APP_NAME.exe)
            VALUE "ProductName",      RCSTR(APP_NAME)
            VALUE "LegalCopyright",   RCSTR(\x00A9 2025 APP_PUBLISHER)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
